# syntax=docker/dockerfile:1
# Нативный образ PgERP (GraalVM native image): исполняемый файл без JVM — быстрый запуск, меньше памяти.
#   docker build -f Dockerfile.native -t pgerp:native .
#   ERP_DOCKERFILE=Dockerfile.native docker compose up -d --build
# Сборке нужно 6–8 ГБ памяти Docker и несколько минут.

# ---------- Сборка ----------
# Oracle GraalVM, последний выпуск линии 25 (в образе community — 25.0.2: плагин берёт с ней старые метаданные)
FROM container-registry.oracle.com/graalvm/native-image:25 AS build
WORKDIR /src
# Обёртке Maven нужен unzip, чтобы распаковать Maven
RUN microdnf install -y unzip findutils && microdnf clean all

COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q -Pnative dependency:go-offline

COPY src src
# Тесты требуют базу данных — их запускают вне сборки образа
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -Pnative -DskipTests native:compile \
 && mkdir /out && cp target/erp-gateway /out/ \
 && (cp target/*.so /out/ 2>/dev/null || true)

# ---------- Запуск ----------
# glibc новее, чем в образе сборки; fontconfig и freetype — для шрифтов отчётов PDF (AWT)
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends fontconfig libfreetype6 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system pgerp && useradd --system --gid pgerp --home-dir /app pgerp
WORKDIR /app

# Исполняемый файл и библиотеки JDK, которые native image подгружает рядом с собой (AWT для отчётов)
COPY --from=build /out/ ./

USER pgerp
EXPOSE 8080

ENV ERP_DB_URL=jdbc:postgresql://db:5432/erp \
    ERP_DB_USER=postgres

ENTRYPOINT ["/app/erp-gateway", "-Djava.awt.headless=true"]
